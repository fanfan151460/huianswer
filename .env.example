# 变量名说明，只有示例；不要把真实密钥写入本文件。
# Spring Boot 不会自动加载此文件或 .env，使用 Windows 用户环境变量。
HUIANSWER_DB_URL=jdbc:postgresql://localhost:5432/huianswer?reWriteBatchedInserts=true
HUIANSWER_DB_USERNAME=postgres
HUIANSWER_DB_PASSWORD=
HUIANSWER_AI_API_KEY=
HUIANSWER_AI_URL=https://api.siliconflow.cn
# 评分脚本仍使用硅基流动；这个变量不再控制应用内的聊天模型。
HUIANSWER_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash

# DeepSeek 官网：应用内回答、改写、意图路由与摘要共用。
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
# 与 application.yml 的 rag.vector.dimension=1024 及数据库列保持一致。
HUIANSWER_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# 原文件与上传临时目录（非密钥）
HUIANSWER_STORAGE_DIR=D:/develop/huiAnswer/data/documents
HUIANSWER_UPLOAD_TEMP_DIR=D:/develop/huiAnswer/data/tmp

# RocketMQ（本地测试使用默认地址）
HUIANSWER_MQ_NAMESERVER=127.0.0.1:9876
HUIANSWER_MQ_TOPIC=huiAnswer-rag-documentToChunk-topic
HUIANSWER_MQ_PRODUCER_GROUP=huiAnswer-rag-document-service
HUIANSWER_MQ_CONSUMER_GROUP=huiAnswer-rag-chunks-service
